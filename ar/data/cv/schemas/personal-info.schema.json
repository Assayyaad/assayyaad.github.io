{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "personal-info.schema.json",

  "title": "PersonalInfo",
  "type": "object",
  "properties": {
    "name": {
      "type": "array",
      "description": "Tuple of [label, full name]",
      "items": [{ "type": "string" }, { "type": "string" }],
      "minItems": 2,
      "maxItems": 2,
      "additionalItems": false
    },
    "age": {
      "type": "array",
      "description": "Tuple of [label, age in years]",
      "items": [{ "type": "string" }, { "type": "number", "minimum": 0 }],
      "minItems": 2,
      "maxItems": 2,
      "additionalItems": false
    },
    "sex": {
      "type": "array",
      "description": "Tuple of [label, biological sex]",
      "items": [{ "type": "string" }, { "type": "string", "enum": ["ذكر", "أنثى"] }],
      "minItems": 2,
      "maxItems": 2,
      "additionalItems": false
    }
  },
  "required": ["name", "age", "sex"],
  "additionalProperties": false
}
