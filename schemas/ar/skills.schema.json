{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "skills.schema.json",

  "title": "المهارات",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "description": "اسم المهارة"
      },
      "efficiency": {
        "type": "number",
        "minimum": 1,
        "maximum": 10,
        "description": "كفاءة المهارة على مقياس من 1 إلى 10"
      }
    },
    "required": ["name", "efficiency"],
    "additionalProperties": false
  }
}
