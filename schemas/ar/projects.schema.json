{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "projects.schema.json",

  "title": "المشاريع",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "description": "اسم المشروع"
      },
      "link": {
        "type": "string",
        "format": "uri",
        "description": "رابط إلى المشروع"
      },
      "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}$",
        "description": "التاريخ بصيغة YYYY-MM"
      },
      "description": {
        "type": "string",
        "description": "وصف المشروع"
      }
    },
    "required": ["name", "link", "date", "description"],
    "additionalProperties": false
  }
}
