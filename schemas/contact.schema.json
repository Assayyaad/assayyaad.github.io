{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "contact.schema.json",

  "title": "التواصل",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "pattern": "^[^@]+@[^@]+\\.[^@]+$",
      "description": "عنوان البريد الإلكتروني بالصيغة: string@string.string"
    },
    "phone": {
      "type": "string",
      "pattern": "^\\+.+$",
      "description": "رقم الهاتف الذي يبدأ بعلامة +"
    }
  },
  "required": ["email", "phone"],
  "additionalProperties": false
}
