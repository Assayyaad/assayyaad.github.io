{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "languages.schema.json",

  "title": "اللغات",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "description": "اسم اللغة"
      },
      "efficiency": {
        "type": "string",
        "enum": ["أصيلة", "طلقة", "متوسطة", "أساسية"],
        "description": "مستوى إتقان اللغة"
      }
    },
    "required": ["name", "efficiency"],
    "additionalProperties": false
  }
}
